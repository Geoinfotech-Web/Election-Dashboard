# Optional: enables NewsAPI headlines on the election-results page.
NEWS_API_KEY=

# GRID3 Nigeria ArcGIS FeatureServer layer URLs (public, no API key).
GRID3_STATE_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_State_Boundaries_V2/FeatureServer/0
GRID3_LGA_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_LGA_Boundaries_2/FeatureServer/0
GRID3_WARD_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_Ward_Boundaries/FeatureServer/0
GRID3_HEALTH_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/GRID3_NGA_health_facilities_v2_0/FeatureServer/0

# Optional Google geocoding for polling-unit points missing coordinates.
GOOGLE_MAPS_API_KEY=
GEOCODE_POLLING_UNITS=false
